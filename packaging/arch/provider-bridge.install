post_install() {
  cat <<'EOF'
Provider Bridge has been installed as /usr/bin/providerbridge.

Default config path:
  ~/provider-bridge/config.yml

Start Provider Bridge after installation:
  providerbridge

Open Web Console:
  http://127.0.0.1:38440/console/

On first run without an existing default config, Provider Bridge creates:
  ~/provider-bridge/config.yml

Example configs remain available under:
  /usr/share/doc/provider-bridge/

Replace provider, model, and API key placeholders before sending real upstream requests.
EOF
}

post_upgrade() {
  post_install
}
